From d30705aa485996148d3f6a31f5cdfad1273cee40 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Felix=20Paul=20K=C3=BChne?= <felix@feepk.net>
Date: Sat, 20 Feb 2021 13:19:24 +0100
Subject: [PATCH 29/44] contrib/ffmpeg: fix cross-compilation for macOS on
 macOS

---
 contrib/src/ffmpeg/rules.mak | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/contrib/src/ffmpeg/rules.mak b/contrib/src/ffmpeg/rules.mak
index d9989c5b06..6e4d66daa3 100644
--- a/contrib/src/ffmpeg/rules.mak
+++ b/contrib/src/ffmpeg/rules.mak
@@ -159,7 +159,7 @@ FFMPEGCONF += --arch=aarch64_32
 else
 FFMPEGCONF += --arch=$(ARCH)
 endif
-FFMPEGCONF += --target-os=darwin --extra-cflags="$(CFLAGS)"
+FFMPEGCONF += --target-os=darwin --extra-cflags="$(CFLAGS)" --enable-pic
 ifdef USE_FFMPEG
 FFMPEGCONF += --disable-lzma
 endif
@@ -167,7 +167,10 @@ ifeq ($(ARCH),x86_64)
 FFMPEGCONF += --cpu=core2
 endif
 ifdef HAVE_IOS
-FFMPEGCONF += --enable-pic --extra-ldflags="$(EXTRA_CFLAGS) -isysroot $(IOS_SDK)"
+FFMPEGCONF += --extra-ldflags="$(EXTRA_CFLAGS) -isysroot $(IOS_SDK)"
+endif
+ifdef HAVE_MACOSX
+FFMPEGCONF += --extra-ldflags="$(EXTRA_LDFLAGS) -isysroot $(MACOSX_SDK)"
 endif
 endif
 
